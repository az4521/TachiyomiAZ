-- Mirrors SearchMetadataTable.createTableQuery (exh gallery metadata).
CREATE TABLE search_metadata(
    manga_id INTEGER NOT NULL PRIMARY KEY,
    uploader TEXT,
    extra TEXT NOT NULL,
    indexed_extra TEXT,
    extra_version INTEGER NOT NULL,
    FOREIGN KEY(manga_id) REFERENCES mangas (_id)
    ON DELETE CASCADE
);

getSearchMetadataForManga:
SELECT * FROM search_metadata WHERE manga_id = ?;

getSearchMetadata:
SELECT * FROM search_metadata;

getSearchMetadataByIndexedExtra:
SELECT * FROM search_metadata WHERE indexed_extra = ?;

insertSearchMetadata:
INSERT OR REPLACE INTO search_metadata(manga_id, uploader, extra, indexed_extra, extra_version)
VALUES (?, ?, ?, ?, ?);

deleteSearchMetadata:
DELETE FROM search_metadata WHERE manga_id = ?;

deleteAllSearchMetadata:
DELETE FROM search_metadata;
