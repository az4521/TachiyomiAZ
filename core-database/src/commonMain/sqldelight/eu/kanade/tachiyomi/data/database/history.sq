-- Mirrors HistoryTable.createTableQuery. Note the column names are prefixed with the
-- table name in the real schema, which is why they read as history_history_id etc.
CREATE TABLE history(
    history_id INTEGER NOT NULL PRIMARY KEY,
    history_chapter_id INTEGER NOT NULL UNIQUE,
    history_last_read INTEGER,
    history_time_read INTEGER,
    FOREIGN KEY(history_chapter_id) REFERENCES chapters (_id)
    ON DELETE CASCADE
);

CREATE INDEX history_history_chapter_id_index ON history(history_chapter_id);

getHistoryByChapterId:
SELECT * FROM history WHERE history_chapter_id = ?;

getAllHistory:
SELECT * FROM history;

getHistoryByMangaId:
SELECT history.* FROM history
JOIN chapters ON history.history_chapter_id = chapters._id
WHERE chapters.manga_id = ?;

getHistoryByChapterUrl:
SELECT history.* FROM history
JOIN chapters ON history.history_chapter_id = chapters._id
WHERE chapters.url = ?;

insertHistory:
INSERT INTO history(history_chapter_id, history_last_read, history_time_read)
VALUES (?, ?, ?);

-- HistoryLastReadPutResolver updated last_read where the chapter matched, and storio's
-- default put inserted when the update affected no rows. Expressed as two statements
-- because SQLDelight's default dialect predates ON CONFLICT DO UPDATE.
updateHistoryLastRead:
UPDATE history SET history_last_read = ? WHERE history_chapter_id = ?;

changes:
SELECT changes();

deleteHistory:
DELETE FROM history;

deleteHistoryNoLastRead:
DELETE FROM history WHERE history_last_read = 0;

lastInsertRowId:
SELECT last_insert_rowid();

-- Recently read manga, one row per manga at its most recently read chapter.
-- offset/limit and the search term were interpolated into the raw SQL before; they are bind
-- parameters now, so the query is static and SQLDelight can type it.
getRecentMangas:
SELECT
    mangas._id AS m_id, mangas.source AS m_source, mangas.url AS mangaUrl,
    mangas.artist AS m_artist, mangas.author AS m_author, mangas.description AS m_description,
    mangas.genre AS m_genre, mangas.title AS m_title, mangas.status AS m_status,
    mangas.thumbnail_url AS m_thumbnail_url, mangas.favorite AS m_favorite,
    mangas.last_update AS m_last_update, mangas.initialized AS m_initialized,
    mangas.viewer AS m_viewer, mangas.chapter_flags AS m_chapter_flags,
    mangas.cover_last_modified AS m_cover_last_modified, mangas.date_added AS m_date_added,
    mangas.update_strategy AS m_update_strategy, mangas.memo AS m_memo,
    chapters.*,
    history.*
FROM mangas
JOIN chapters ON mangas._id = chapters.manga_id
JOIN history ON chapters._id = history.history_chapter_id
JOIN (
    SELECT chapters.manga_id, chapters._id AS history_chapter_id,
           MAX(history.history_last_read) AS history_last_read
    FROM chapters JOIN history ON chapters._id = history.history_chapter_id
    GROUP BY chapters.manga_id
) AS max_last_read
ON chapters.manga_id = max_last_read.manga_id
WHERE history.history_last_read > :after
AND max_last_read.history_chapter_id = history.history_chapter_id
AND lower(mangas.title) LIKE ('%' || :search || '%')
ORDER BY max_last_read.history_last_read DESC
LIMIT :limit OFFSET :offset;
