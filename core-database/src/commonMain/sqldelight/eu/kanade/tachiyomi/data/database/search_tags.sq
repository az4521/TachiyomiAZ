-- Mirrors SearchTagTable.createTableQuery (exh gallery tags).
CREATE TABLE search_tags(
    _id INTEGER NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL,
    namespace TEXT,
    name TEXT NOT NULL,
    type INTEGER NOT NULL,
    FOREIGN KEY(manga_id) REFERENCES mangas (_id)
    ON DELETE CASCADE
);

getSearchTagsForManga:
SELECT * FROM search_tags WHERE manga_id = ?;

insertSearchTag:
INSERT INTO search_tags(manga_id, namespace, name, type) VALUES (?, ?, ?, ?);

deleteSearchTagsForManga:
DELETE FROM search_tags WHERE manga_id = ?;

deleteAllSearchTags:
DELETE FROM search_tags;

lastInsertRowId:
SELECT last_insert_rowid();
