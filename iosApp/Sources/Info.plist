		<dict>
			<key>CFBundleURLName</key>
			<string>eu.kanade.tachiyomi.az.ios.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tachiyomiaz</string>
				<string>aidoku</string>
			</array>
