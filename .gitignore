.gradle
.kotlin
/local.properties
/.idea/workspace.xml
.DS_Store
# AppleDouble sidecars. macOS writes these onto SMB shares just from browsing one, so
# they appear in the working tree without anyone editing anything.
._*
.idea/
*iml
*.iml
/mainframer
/.mainframer
TODO.md
CHANGELOG.md
/captures
build.sh
test.sh

# Built files
*/build
/build
*.apk
*.idsig
app/**/output.json


# Hebrew assets are copied on build
app/src/main/res/values-iw/

# XcodeGen output and Xcode build products
/iosApp/*.xcodeproj
# Xcode derived data. Named per configuration rather than one directory, so each is listed --
# and a glob, because CI adds its own (build-ci) and a stray one gets committed otherwise.
/iosApp/build/
/iosApp/build-device/
/iosApp/build-*/
# JVM runtime binaries: ~200MB, built by tachiyomiazios Scripts/. See IOS_PORT.md.
/iosApp/Vendor/
/iosApp/Resources/JVM/

# Texture (AsyncDisplayKit), fetched by iosApp/Scripts/fetch-texture.sh
iosApp/Vendor/AsyncDisplayKit.xcframework/

# JVM runtime build output. The sources under Runtime/ are tracked; the jars they
# produce are not, except the two checked-in distributions the iOS build stages.
/Runtime/ExtensionHost/build/
/Runtime/ExtensionHost/dist/*
!/Runtime/ExtensionHost/dist/tachiaz-extension-host.jar
/Runtime/ExtensionHost/compat/*
!/Runtime/ExtensionHost/compat/README.md
/Runtime/MobileShims/build/
/Runtime/MobileShims/dist/*
!/Runtime/MobileShims/dist/tachiaz-mobile-shims.jar
!/Runtime/MobileShims/dist/cacerts
/Runtime/MobileCompatShims/build/
/Runtime/MobileCompatShims/test-build/
