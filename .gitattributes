* text=auto
* text eol=lf

# Windows forced line-endings
/.idea/* text eol=crlf

# Gradle wrapper
*.jar binary

# JDK trust store staged into the iOS app. No file extension, so the blanket
# `* text eol=lf` above would rewrite line endings inside a binary keystore.
Runtime/MobileShims/dist/cacerts binary

# Images
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.pyc binary
*.swp binary

